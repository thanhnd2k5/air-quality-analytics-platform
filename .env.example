# ==============================================================================
# Air Quality Analytics Platform - Environment Configuration Template
# Copy to `.env` and adjust values. Never commit a real `.env` with secrets.
# ==============================================================================

# Project
ENVIRONMENT=development
DOCKER_NETWORK=air-quality-network

# ------------------------------------------------------------------------------
# PostgreSQL (one instance, two logical databases)
# - POSTGRES_DB  = warehouse (schemas: staging, dwh, mart)  → service name: postgres
# - airflow_db   = Airflow metadata (created by config/postgres/init)
# From other containers use host `postgres`, not localhost.
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=air_quality_dw
POSTGRES_HOST=localhost
# Host port (container still listens on 5432). Use 5433 if local Postgres already owns 5432.
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# MinIO (Data Lake) — ARCHITECTURE §8: single bucket + prefixes
# From other containers use host `minio` and port 9000.
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword_here
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_PORT=9000
MINIO_BUCKET=air-quality-lake
# Compatibility aliases used by some clients (same credentials as root):
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword_here
# IMPORTANT: MINIO_ACCESS_KEY / MINIO_SECRET_KEY must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# (compose Airflow clients use MINIO_ROOT_*). Keep them identical for local setup.
# false for local HTTP; Airflow compose overrides endpoint to minio:9000
MINIO_SECURE=false

# Optional: packages installed into Airflow webserver/scheduler on start.
# Compose default is minio + pyarrow==25.0.1. The Airflow image ships pyarrow 19,
# which cannot read Parquet written by pyarrow 25 (repetition-level histogram).
# Override must keep both packages and a pyarrow that can read those files.
# _PIP_ADDITIONAL_REQUIREMENTS=minio>=7.1.15 pyarrow==25.0.1

# ------------------------------------------------------------------------------
# Apache Airflow (LocalExecutor — see config/airflow/README.md)
# Compose builds SQLAlchemy URL from POSTGRES_USER / POSTGRES_PASSWORD
# → postgresql+psycopg2://…@postgres:5432/airflow_db
# Keep passwords free of @ : / # ? so URL interpolation stays valid.
# ------------------------------------------------------------------------------
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_WEBSERVER_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin_password_here
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
# Optional: set a stable Fernet key for connection encryption (empty = generate each init)
# AIRFLOW__CORE__FERNET_KEY=

# ------------------------------------------------------------------------------
# Dashboard (Phase 11) — FastAPI + Vite React
# Compose: docker compose up -d postgres dashboard-api
# Web local: cd dashboard/web && npm run dev  → http://localhost:5173
# ------------------------------------------------------------------------------
DASHBOARD_API_HOST=0.0.0.0
# Host port (Compose maps → container :8000). Default 8100 — tránh đụng app khác trên :8000.
DASHBOARD_API_PORT=8100
# Để trống khi dùng Vite proxy (/api → :8100). Chỉ set nếu gọi API tuyệt đối.
# VITE_API_BASE_URL=http://localhost:8100
# Exact origins (optional). Localhost ANY port already allowed via CORS_ORIGIN_REGEX in API.
# CORS_ORIGINS=http://localhost:5175
# CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$
