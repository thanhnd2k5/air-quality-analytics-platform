# ==============================================================================
# Air Quality Analytics Platform - Environment Configuration Template
# Sao chép file này thành .env và điền các giá trị thực tế.
# LƯU Ý: Không bao giờ commit file .env thật chứa thông tin mật lên Git.
# ==============================================================================

# Project Environment
ENVIRONMENT=development

# PostgreSQL (Staging & Data Warehouse)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=air_quality_dwh
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO (Object Storage / Data Lake)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword_here
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_RAW=air-quality-raw
MINIO_BUCKET_PROCESSED=air-quality-processed

# Apache Airflow
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin_password_here

# Streamlit Dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
